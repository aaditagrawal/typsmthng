-        Some(builder.0)
+static OUTLINE_CACHE: LazyLock<Mutex<OutlineCache>> = LazyLock::new(Default::default);
+
+fn cached_outline_glyph(font: &Font, id: u16) -> Option<String> {
+    let key = (font.clone(), id);
+    if let Some(outline) = OUTLINE_CACHE.lock().outlines.get(&key) {
+        return outline.clone();
+    }
+
+    let mut builder = SvgOutlineBuilder(String::new());
+    let outline = font
+        .ttf()
+        .outline_glyph(GlyphId(id), &mut builder)
+        .map(|_| builder.0);
+    let bytes = outline.as_ref().map_or(0, String::len);
+    const MAX_BYTES: usize = 2 * 1024 * 1024;
+    if bytes > MAX_BYTES {
+        return outline;
+    }
+
+    let mut cache = OUTLINE_CACHE.lock();
+    if cache.outlines.len() >= 2048
+        || cache.bytes + bytes > MAX_BYTES
+        || (cache.fonts.len() >= 32 && !cache.fonts.contains(font))
+    {
+        *cache = OutlineCache::default();
+    }
+    // Another exporter may have inserted this key while we built the outline.
+    if !cache.outlines.contains_key(&key) {
+        cache.bytes += bytes;
+        cache.fonts.insert(font.clone());
+        cache.outlines.insert(key, outline.clone());
     }
+    outline
 }
 
