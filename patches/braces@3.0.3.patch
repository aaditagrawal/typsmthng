diff --git a/node_modules/braces/lib/walk.js b/lib/walk.js
new file mode 100644
index 0000000000000000000000000000000000000000..e2dd4cfe1a298efa073dbad16e42972aaa701344
--- /dev/null
+++ b/lib/walk.js
@@ -0,0 +1,19 @@
+'use strict';
+
+// Run suspended tree visits on an explicit heap stack. The parser's existing
+// character limit still applies; valid deeply nested patterns need no depth cap.
+module.exports = (visit, ...args) => {
+  const stack = [visit(...args)];
+  let value;
+  while (stack.length > 0) {
+    const step = stack[stack.length - 1].next(value);
+    if (step.done) {
+      stack.pop();
+      value = step.value;
+    } else {
+      stack.push(visit(...step.value));
+      value = undefined;
+    }
+  }
+  return value;
+};
