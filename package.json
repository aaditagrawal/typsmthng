    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
