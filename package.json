{
  "name": "typsmthng",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:portless": "portless run",
    "build": "bun run compiler:check && tsrs -b && vite build && bun scripts/check-compiler.mjs --dist",
    "compiler:build": "bun scripts/build-compiler.mjs",
    "compiler:check": "bun scripts/check-compiler.mjs",
    "compiler:bench": "bun scripts/bench-compiler.mjs",
    "compiler:fonts": "bun scripts/fetch-compiler-fonts.mjs",
    "compiler:test": "bun scripts/test-compiler.mjs",
    "compiler:test:cache": "uv run --no-project --with fonttools==4.67.0 scripts/prepare-compiler-cache-fixtures.py && bun scripts/test-compiler-font-cache.mjs",
    "build:budget": "bun run build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsrs -b",
    "preview": "vite preview",
    "test:security": "node scripts/security-braces.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/geist-mono": "^5.3.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0-rc2",
    "@myriaddreamin/typst.ts": "0.7.0-rc2",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@stylexjs/stylex": "^0.19.1",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "^0.6.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "@rolldown/plugin-babel": "^0.2.4",
