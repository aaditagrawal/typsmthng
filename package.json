  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:portless": "portless run",
    "build": "tsrs -b && vite build",
    "build:budget": "bun run build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && playwright test",
    "test:helium": "bun run build && HELIUM_PATH='/Applications/Helium.app/Contents/MacOS/Helium' playwright test --headed",
    "typecheck": "tsrs -b",
    "preview": "vite preview"
  },
